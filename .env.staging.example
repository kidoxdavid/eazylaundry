# Copy to .env.staging and replace every CHANGE_ME with a long random URL-safe value: openssl rand -hex 24
# Never commit .env.staging. Keep APP_ENCRYPTION_SECRET safe and backed up: it protects stored MFA seeds and delivery codes.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
EAZY_OWNER_PASSWORD=CHANGE_ME
EAZY_APP_PASSWORD=CHANGE_ME
EAZY_WORKER_PASSWORD=CHANGE_ME
EAZY_PLATFORM_PASSWORD=CHANGE_ME
APP_ENCRYPTION_SECRET=CHANGE_ME
# Address people use to reach the web port (used in links inside emails)
PUBLIC_WEB_URL=https://staging.example.com
# Leave true behind HTTPS. Only set false for a plain-http local trial.
SESSION_COOKIE_SECURE=true
WEB_PORT=8080
# Outbound email. Empty = messages are recorded as "logged" and NOT delivered.
SMTP_URL=
MAIL_FROM="Your Laundry <no-reply@example.com>"

# Owner role: migrations only. App role: API/worker (no BYPASSRLS, not table owner).
DATABASE_OWNER_URL=postgres://eazy_owner:eazy_owner_dev@localhost:5432/eazylaundry
DATABASE_URL=postgres://eazy_app:eazy_app_dev@localhost:5432/eazylaundry
SESSION_COOKIE_SECURE=false
PORT=3000
# Background worker (notifications) connects with its own least-privilege role.
DATABASE_WORKER_URL=postgres://eazy_worker:eazy_worker_dev@localhost:5432/eazylaundry
# Outbound email. Leave empty in development: messages are recorded as 'logged' and are NOT delivered.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="Your Laundry <no-reply@example.com>"
# Public web address used in links inside emails
PUBLIC_WEB_URL=http://localhost:5173
# Platform console (Eazy Group SaaS operations). Separate role: sees tenant metadata and usage COUNTS only, never business data.
DATABASE_PLATFORM_URL=postgres://eazy_platform:eazy_platform_dev@localhost:5432/eazylaundry
